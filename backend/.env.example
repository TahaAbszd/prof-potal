PORT=8080
DATABASE_PATH=./data/portal.db
SEED_DATA_PATH=../data/professors.json
RESUME_FONT_PATH=../public/fonts/IRANSansWeb.woff2
PUBLIC_ORIGIN=http://localhost:3000
CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
COOKIE_SECURE=false
GIN_MODE=release
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=hormozgan:portal
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_FACULTY_PASSWORD=replace-with-a-different-long-random-password
